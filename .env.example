# Server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# MongoDB (use MongoDB Atlas for a URI that works both locally and on Render)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meridian-bank

# Sessions
SESSION_SECRET=change-this-to-a-long-random-string

# Brevo (transactional email). Leave blank in development to use the console fallback.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@meridianbank.demo
BREVO_SENDER_NAME=Meridian Bank

# Branding
BANK_NAME=Meridian Bank
SUPPORT_EMAIL=support@meridianbank.demo

# Seed admin (used only by npm run seed)
SEED_ADMIN_EMAIL=admin@meridianbank.demo
SEED_ADMIN_PASSWORD=ChangeMe123!
