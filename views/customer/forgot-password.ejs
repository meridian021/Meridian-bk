<section class="container-narrow" style="padding: 64px 24px;">
  <div class="card">
    <h2>Forgot your password?</h2>
    <p style="color:var(--color-ink-muted); font-size:0.92rem;">
      Enter the email on your account and we'll send you a 6-digit code to reset your password.
    </p>

    <% if (error) { %><div class="error-banner"><%= error %></div><% } %>

    <form method="POST" action="/auth/forgot" id="forgotForm">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Send reset code</button>
    </form>

    <div class="notice-box" style="margin-top:18px;">
      The code can take a minute to arrive. If you can't find it, check your <strong>spam or junk</strong> folder.
    </div>

    <p style="text-align:center; font-size:0.85rem; margin-top:16px;">
      <a href="/auth/login" style="color:var(--color-primary); font-weight:500;">Back to log in</a>
    </p>
  </div>
</section>
<script>
  document.getElementById('forgotForm').addEventListener('submit', function () {
    showLoadingSequence(['Sending reset code...']);
  });
</script>