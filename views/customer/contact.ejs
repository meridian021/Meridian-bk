<section class="contact-hero">
  <h1 style="font-size:2.2rem; margin-bottom:10px;">We're here to help</h1>
  <p style="color:var(--color-ink-muted); max-width:520px; margin:0 auto;">
    Questions about your account, a payment, or how things work? Send us a message and we'll reply by email.
  </p>
</section>

<div class="contact-grid">
  <div>
    <div class="contact-info-item">
      <div class="contact-info-icon">✉</div>
      <div>
        <strong>We reply by email</strong>
        <p style="margin:4px 0 0; color:var(--color-ink-muted); font-size:0.88rem;">Our team answers at the address you give us, usually within 1 to 2 business days.</p>
      </div>
    </div>
    <div class="contact-info-item">
      <div class="contact-info-icon">⏱</div>
      <div>
        <strong>Check your spam folder</strong>
        <p style="margin:4px 0 0; color:var(--color-ink-muted); font-size:0.88rem;">Our replies sometimes land in spam or junk. If you're waiting to hear from us, look there first.</p>
      </div>
    </div>
    <div class="contact-info-item">
      <div class="contact-info-icon">🔒</div>
      <div>
        <strong>Keep your details private</strong>
        <p style="margin:4px 0 0; color:var(--color-ink-muted); font-size:0.88rem;">We will never ask for your password, PIN, or verification codes.</p>
      </div>
    </div>
  </div>

  <div class="card">
    <% if (sent) { %>
      <h3 style="margin-top:0;">Message sent ✓</h3>
      <p style="color:var(--color-ink-muted);">Thanks for reaching out. We'll reply to the email address you provided.</p>
      <div class="notice-box">Can't find our reply? Check your <strong>spam or junk</strong> folder.</div>
      <a href="/contact" class="btn btn-secondary" style="margin-top:16px;">Send another message</a>
    <% } else { %>
      <h3 style="margin-top:0;">Send us a message</h3>
      <% if (error) { %><div class="error-banner"><%= error %></div><% } %>

      <form method="POST" action="/contact" id="contactForm">
        <div style="position:absolute; left:-9999px;" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off">
        </div>
        <div class="field">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" maxlength="100" value="<%= formData.name || '' %>" required>
        </div>
        <div class="field">
          <label for="email">Your email</label>
          <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required>
        </div>
        <div class="field">
          <label for="category">Topic</label>
          <select id="category" name="category">
            <% categories.forEach(function(c) { %>
              <option value="<%= c %>" <%= formData.category === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" maxlength="150" value="<%= formData.subject || '' %>" required>
        </div>
        <div class="field">
          <label for="message">How can we help?</label>
          <textarea id="message" name="message" rows="6" maxlength="5000" required><%= formData.message || '' %></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Send message</button>
      </form>
    <% } %>
  </div>
</div>
<script>
  const contactForm = document.getElementById('contactForm');
  if (contactForm) {
    contactForm.addEventListener('submit', function () {
      showLoadingSequence(['Sending your message...']);
    });
  }
</script>