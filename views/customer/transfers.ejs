<div class="app-shell">
  <%- include('../partials/sidebar', { activePage: 'transfers' }) %>
  <div class="app-main">
    <h2 style="margin-top:0; margin-bottom: 10px;">Transfers</h2>
    <div class="card">
      <h3 style="margin-top:0;">Internal transfer</h3>
      <p style="color:var(--color-ink-muted); font-size:0.85rem;">Requires an active transfer PIN.</p>
      <form>
        <div class="field">
          <label for="recipientNameInt">Recipient name</label>
          <input type="text" id="recipientNameInt" placeholder="Full name">
        </div>
        <div class="field">
          <label for="recipientAccount">Recipient account number</label>
          <input type="text" id="recipientAccount" placeholder="e.g. MB4821309213">
        </div>
        <div class="field">
          <label for="amountInt">Amount</label>
          <input type="number" id="amountInt" step="0.01" placeholder="0.00">
        </div>

        <div class="field">
          <label for="transferPin">Transfer PIN</label>
          <div style="display:flex; gap:10px; align-items:center;">
            <input type="password" id="transferPin" maxlength="4" placeholder="You don't have an active PIN" disabled style="flex:1;">
            <a href="/account/create-pin" class="btn btn-secondary" style="white-space:nowrap;">Create PIN</a>
          </div>
        </div>

        <button type="button" class="btn btn-primary btn-block" disabled>Make transfer</button>
      </form>
    </div>
    <div class="card" style="margin-bottom:20px; margin-top: 20px;">
      <h3 style="margin-top:0;">Transfer history</h3>
      <% if (transfers.length === 0) { %>
        <div class="empty-state">No transfers yet.</div>
      <% } else { %>
        <% transfers.forEach(function(t) { %>
          <div class="tx-row">
            <div>
              <div class="tx-desc"><%= t.recipientName %> — <%= t.bankName %></div>
              <div class="tx-meta"><%= new Date(t.createdAt).toLocaleString() %></div>
              <% if ((t.status === 'rejected' || t.status === 'held') && t.rejectionReason) { %>
                <div style="font-size:0.8rem; color:var(--color-error); margin-top:4px;">Reason: <%= t.rejectionReason %></div>
              <% } %>
            </div>
            <div style="text-align:right;">
              <div class="tx-amount"><%= t.currency %> <%= t.amount.toLocaleString(undefined, {minimumFractionDigits: 2}) %></div>
              <span class="badge badge-<%= t.status === 'successful' ? 'success' : ((t.status === 'pending' || t.status === 'held') ? 'pending' : 'error') %>"><%= t.status %></span>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
    <div class="card" style="margin-bottom:20px;">
      <h3 style="margin-top:0;">International / external transfer</h3>

      <% if (error) { %>
        <div class="error-banner"><%= error %></div>
      <% } %>

      <form method="POST" action="/account/transfers/external" id="externalTransferForm">
        <div class="field">
          <label for="recipientName">Recipient name</label>
          <input type="text" id="recipientName" name="recipientName" required>
        </div>
        <div class="field">
          <label for="bankName">Recipient bank name</label>
          <input type="text" id="bankName" name="bankName" required>
        </div>
        <div class="field">
          <label for="externalAccountNumber">Account number</label>
          <input type="text" id="externalAccountNumber" name="externalAccountNumber" required>
        </div>
        <div class="field">
          <label for="iban">IBAN (if applicable)</label>
          <input type="text" id="iban" name="iban">
        </div>
        <div class="field">
          <label for="swiftBic">SWIFT/BIC (if applicable)</label>
          <input type="text" id="swiftBic" name="swiftBic">
        </div>
        <div class="field">
          <label for="country">Recipient country</label>
          <input type="text" id="country" name="country" required>
        </div>
        <div class="field">
          <label for="amount">Amount</label>
          <input type="number" id="amount" name="amount" step="0.01" min="0.01" required>
        </div>
        <div class="field">
          <label for="purpose">Transfer purpose</label>
          <input type="text" id="purpose" name="purpose" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Submit transfer</button>
      </form>
    </div>

    

    
  </div>
</div>
<script>
  document.getElementById('externalTransferForm').addEventListener('submit', function (e) {
    e.preventDefault();
    const form = e.target;
    showLoadingSequence(['Submitting transfer request...', 'Sending to recipient bank...']).then(() => form.submit());
  });
</script>