<div class="app-shell">
  <%- include('../partials/adminSidebar', { activePage: 'kyc' }) %>
  <div class="app-main">
    <a href="/admin/kyc" style="font-size:0.85rem; color:var(--color-ink-muted);">← Back to KYC review</a>
    <h2 style="margin-top:8px;"><%= application.userId.firstName %> <%= application.userId.lastName %> — Tier <%= application.tierRequested %></h2>

    <div class="card" style="margin-bottom:16px;">
      <h3 style="margin-top:0;">Submitted information</h3>
      <div class="profile-grid" style="font-size:0.9rem;">
        <% Object.entries(application.submittedInfo || {}).forEach(function([key, value]) { %>
          <% if (value) { %>
            <div><span style="color:var(--color-ink-muted); text-transform:capitalize;"><%= key.replace(/([A-Z])/g, ' $1') %></span><br><%= value %></div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <div class="card" style="margin-bottom:16px;">
      <h3 style="margin-top:0;">Documents</h3>
      <% documents.forEach(function(doc) { %>
        <div class="tx-row">
          <div class="tx-desc"><%= doc.documentType.replace('_', ' ') %> — <%= doc.originalName %></div>
          <a href="/admin/documents/<%= doc._id %>" target="_blank" class="btn btn-secondary" style="padding:6px 12px;">View</a>
        </div>
      <% }); %>
    </div>

    <div class="card">
      <h3 style="margin-top:0;">Decision</h3>
      <form method="POST" action="/admin/kyc/<%= application._id %>/approve" style="display:inline-block; margin-right:10px;">
        <button type="submit" class="btn btn-primary">Approve</button>
      </form>
      <form method="POST" action="/admin/kyc/<%= application._id %>/reject" style="display:inline-block;">
        <input type="text" name="reason" placeholder="Rejection reason" style="padding:10px 12px; border-radius:8px; border:1px solid var(--color-border); margin-right:8px;">
        <button type="submit" class="btn btn-secondary">Reject</button>
      </form>
    </div>
  </div>
</div>