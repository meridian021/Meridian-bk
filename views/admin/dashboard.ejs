<section class="admin-page">
  <div class="admin-page-header">
    <div>
      <p class="admin-eyebrow">MERIDIAN BANK · ADMIN</p>
      <h1>Overview</h1>
      <p class="admin-page-subtitle">
        Monitor customers, accounts and activity across the platform.
      </p>
    </div>

    <div class="admin-status">
      <span></span>
      System overview
    </div>
  </div>

  <!-- Customer metrics -->
  <section class="admin-section">
    <div class="admin-section-heading">
      <div>
        <h2>Customers</h2>
        <p>Account activity and customer distribution.</p>
      </div>
    </div>

    <div class="admin-stat-grid">

      <div class="admin-stat-card admin-stat-featured">
        <div class="admin-stat-top">
          <span>Total customers</span>
          <span class="admin-stat-icon">◎</span>
        </div>
        <strong><%= totalCustomers %></strong>
        <small>Registered customers</small>
      </div>

      <div class="admin-stat-card">
        <div class="admin-stat-top">
          <span>Active accounts</span>
          <span class="admin-stat-icon">✓</span>
        </div>
        <strong><%= activeAccounts %></strong>
        <small>Currently active</small>
      </div>

      <div class="admin-stat-card">
        <div class="admin-stat-top">
          <span>Pending KYC</span>
          <span class="admin-stat-icon admin-stat-icon-warning">!</span>
        </div>
        <strong><%= pendingKyc %></strong>
        <small>Awaiting review</small>
      </div>

    </div>

    <div class="admin-tier-grid">
      <% [1, 2, 3].forEach(function(t) { %>
        <% const match = tierCounts.find(function(tc) { return tc._id === t; }); %>

        <div class="admin-tier-card">
          <span>Tier <%= t %></span>
          <strong><%= match ? match.count : 0 %></strong>
          <small>accounts</small>
        </div>
      <% }); %>
    </div>
  </section>


  <!-- Awaiting review -->
  <section class="admin-section admin-review-section">

    <div class="admin-section-heading">
      <div>
        <h2>Awaiting your review</h2>
        <p>Items that may require administrative attention.</p>
      </div>
    </div>

    <div class="admin-review-grid">

      <a href="/admin/transfers" class="admin-review-card">
        <div class="admin-review-icon">↗</div>

        <div class="admin-review-content">
          <strong>Pending transfers</strong>
          <span>Transfers awaiting review</span>
        </div>

        <div class="admin-review-number">
          <%= pendingTransfers %>
          <span>→</span>
        </div>
      </a>


      <a href="/admin/cards" class="admin-review-card">
        <div class="admin-review-icon">▣</div>

        <div class="admin-review-content">
          <strong>Pending card requests</strong>
          <span>Cards awaiting processing</span>
        </div>

        <div class="admin-review-number">
          <%= pendingCards %>
          <span>→</span>
        </div>
      </a>


      <a href="/admin/crypto" class="admin-review-card">
        <div class="admin-review-icon">₿</div>

        <div class="admin-review-content">
          <strong>Pending crypto deposits</strong>
          <span>Deposits awaiting review</span>
        </div>

        <div class="admin-review-number">
          <%= pendingCrypto %>
          <span>→</span>
        </div>
      </a>


      <a href="/admin/card-topups" class="admin-review-card">
        <div class="admin-review-icon">+</div>

        <div class="admin-review-content">
          <strong>Pending card top-ups</strong>
          <span>Top-ups awaiting processing</span>
        </div>

        <div class="admin-review-number">
          <%= pendingCardTopUps %>
          <span>→</span>
        </div>
      </a>

    </div>

  </section>
</section>