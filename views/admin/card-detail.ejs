<div class="app-shell">
  <%- include('../partials/adminSidebar', { activePage: 'cards' }) %>
  <div class="app-main">
    <a href="/admin/cards" style="font-size:0.85rem; color:var(--color-ink-muted);">← Back to cards</a>
    <h2 style="margin-top:8px;"><%= card.userId.firstName %> <%= card.userId.lastName %></h2>
    <span class="badge badge-<%= card.status === 'activated' || card.status === 'delivered' ? 'success' : (card.status === 'rejected' ? 'error' : 'pending') %>"><%= card.status %></span>

    <div class="card" style="margin: 16px 0;">
      <h3 style="margin-top:0;">Details</h3>
            <div class="profile-grid" style="font-size:0.9rem;">
        <div><span style="color:var(--color-ink-muted);">Fee</span><br><%= card.feeAmount %></div>
        <div><span style="color:var(--color-ink-muted);">Shipping address</span><br><%= card.shippingAddress %></div>
        <div><span style="color:var(--color-ink-muted);">Expected delivery</span><br><%= card.expectedDeliveryDate ? new Date(card.expectedDeliveryDate).toDateString() : '—' %></div>
        <% if (card.delayReason) { %>
          <div><span style="color:var(--color-ink-muted);">Delay/rejection reason</span><br><%= card.delayReason %></div>
        <% } %>
      </div>
    </div>

    <% if (card.status === 'requested') { %>
      <div class="card">
        <h3 style="margin-top:0;">Decision</h3>
        <form method="POST" action="/admin/cards/<%= card._id %>/approve" style="display:inline-block; margin-right:10px;">
          <button type="submit" class="btn btn-primary">Approve</button>
        </form>
        <form method="POST" action="/admin/cards/<%= card._id %>/reject" style="display:inline-block;">
          <input type="text" name="reason" placeholder="Rejection reason" style="padding:10px 12px; border-radius:8px; border:1px solid var(--color-border); margin-right:8px;">
          <button type="submit" class="btn btn-secondary">Reject</button>
        </form>
      </div>
    <% } %>

    <% if (['approved', 'delayed', 'shipped'].includes(card.status)) { %>
      <div class="card" style="margin-top:16px;">
        <h3 style="margin-top:0;">Delivery management</h3>
        <form method="POST" action="/admin/cards/<%= card._id %>/delay" class="inline-form" style="margin-bottom:14px;">
          <div class="field">
            <label>New delivery date</label>
            <input type="date" name="newDate" required>
          </div>
          <div class="field" style="min-width:200px;">
            <label>Delay reason</label>
            <input type="text" name="reason" required>
          </div>
          <button type="submit" class="btn btn-secondary">Delay</button>
        </form>

        <% if (card.status !== 'shipped') { %>
          <form method="POST" action="/admin/cards/<%= card._id %>/ship" style="display:inline-block; margin-right:10px;">
            <button type="submit" class="btn btn-secondary">Mark shipped</button>
          </form>
        <% } %>
        <form method="POST" action="/admin/cards/<%= card._id %>/deliver" style="display:inline-block;">
          <button type="submit" class="btn btn-primary">Mark delivered</button>
        </form>
      </div>
    <% } %>
  </div>
</div>