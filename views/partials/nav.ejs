<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="brand"><%= bankName %></a>

    <!-- Desktop navigation -->
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/contact">Contact us</a>

      <% if (currentUser) { %>
        <a href="/account/dashboard">Dashboard</a>

        <form method="POST" action="/auth/logout" style="display:inline;">
          <button class="btn btn-secondary" type="submit" style="padding:6px 14px;">
            Log out
          </button>
        </form>
      <% } else { %>
        <a href="/auth/login">Log in</a>
        <a href="/auth/register" class="btn btn-primary" style="padding:8px 18px;">
          Open an account
        </a>
      <% } %>
    </div>

    <!-- Mobile menu -->
    <details class="mobile-nav">
      <summary class="mobile-nav-toggle">
        <span>Menu</span>
        <span class="mobile-nav-icon">☰</span>
      </summary>

      <div class="mobile-nav-dropdown">
        <a href="/">Home</a>
        <a href="/contact">Contact us</a>

        <% if (currentUser) { %>
          <a href="/account/dashboard">Dashboard</a>

          <form method="POST" action="/auth/logout">
            <button type="submit">Log out</button>
          </form>
        <% } else { %>
          <a href="/auth/login">Log in</a>
          <a href="/auth/register" class="mobile-nav-primary">
            Open an account
          </a>
        <% } %>
      </div>
    </details>
  </div>
</nav>